<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    >

    <TextView
        android:id="@+id/custom_product_layout_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:paddingLeft="@dimen/_10sdp"
        android:text="product name"
        android:textSize="@dimen/_18sdp"
        />
    <TextView
        android:id="@+id/custom_product_layout_vendor_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Vendor name"
        android:paddingLeft="@dimen/_10sdp"
        android:textSize="@dimen/_14sdp"
        />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >

        <TextView
            android:id="@+id/custom_product_layout_original_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Original Price"
            android:paddingLeft="@dimen/_10sdp"
            android:textSize="@dimen/_10sdp"
            />
        <TextView
            android:id="@+id/custom_product_layout_discount_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Discounted Price"
            android:paddingLeft="@dimen/_10sdp"
            android:textSize="@dimen/_12sdp"
            />

        <TextView
            android:id="@+id/custom_product_layout_discount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Discounted percentage"
            android:paddingLeft="@dimen/_10sdp"
            android:textSize="@dimen/_12sdp"
            />

    </LinearLayout>

</LinearLayout>