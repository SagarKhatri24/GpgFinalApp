<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="@dimen/_7sdp"
    app:cardElevation="@dimen/_3sdp"
    app:cardCornerRadius="@dimen/_7sdp"

    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/custom_product_image"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_100sdp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >

                <TextView
                    android:id="@+id/custom_cart_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/_10sdp"
                    android:text="product name"
                    android:layout_toLeftOf="@id/custom_cart_delete"
                    android:textSize="@dimen/_18sdp"
                    />

                <ImageView
                    android:id="@+id/custom_cart_delete"
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:src="@drawable/delete"
                    android:layout_gravity="end"
                    android:layout_alignParentRight="true"
                    android:layout_margin="@dimen/_5sdp"
                    />

            </RelativeLayout>

            <TextView
                android:id="@+id/custom_cart_vendor_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vendor name"
                android:paddingLeft="@dimen/_10sdp"
                android:textSize="@dimen/_14sdp"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >

                <TextView
                    android:id="@+id/custom_cart_original_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Original Price"
                    android:paddingLeft="@dimen/_10sdp"
                    android:textSize="@dimen/_10sdp"
                    />
                <TextView
                    android:id="@+id/custom_cart_discount_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Discounted Price"
                    android:paddingLeft="@dimen/_10sdp"
                    android:textSize="@dimen/_12sdp"
                    />

                <TextView
                    android:id="@+id/custom_cart_discount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Discounted percentage"
                    android:paddingLeft="@dimen/_10sdp"
                    android:textSize="@dimen/_12sdp"
                    />



            </LinearLayout>
        </LinearLayout>


    </LinearLayout>

</androidx.cardview.widget.CardView>